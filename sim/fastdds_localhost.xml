<?xml version="1.0" encoding="UTF-8"?>
<!-- Localhost-only DDS discovery for the ~60 sim/Nav2 processes (see sim/env.sh for why).
     Unicast to 127.0.0.1 for participant ports 0..127, plus shared memory. No multicast (ufw drops it). -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>udp_lo</transport_id>
      <type>UDPv4</type>
      <interfaceWhiteList><address>127.0.0.1</address></interfaceWhiteList>
      <maxInitialPeersRange>128</maxInitialPeersRange>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>shm</transport_id>
      <type>SHM</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="localhost_many" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>udp_lo</transport_id>
        <transport_id>shm</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
      <builtin>
        <initialPeersList>
          <locator><udpv4><address>127.0.0.1</address></udpv4></locator>
        </initialPeersList>
      </builtin>
    </rtps>
  </participant>
</profiles>
